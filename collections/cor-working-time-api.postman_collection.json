          "name": "Create or update working time",
          "request": {
            "name": "Create or update working time",
            "description": {
              "content": "Creates or updates the user's working time schedule.\n\n**Fields:**\n- `dayOfWeek` — Day of the week (1 = Sunday, 7 = Saturday)\n- `start` — Start time in HH:MM format (24-hour clock)\n- `end` — End time in HH:MM format (24-hour clock)\n- `breakTime` — Break duration in hours. Valid values: 0, 0.25, 0.5, 0.75, 1, 1.5, 2",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "working-time"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"<integer>\",\n  \"companyId\": \"<integer>\",\n  \"workingTimes\": [\n    {\n      \"dayOfWeek\": \"<string>\",\n      \"start\": \"<string>\",\n      \"end\": \"<string>\",\n      \"breakTime\": \"<string>\"\n    },\n    {\n      \"dayOfWeek\": \"<string>\",\n      \"start\": \"<string>\",\n      \"end\": \"<string>\",\n      \"breakTime\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "81b70542-28e0-432f-8478-25467cff5c72",
              "name": "Working time saved successfully",
