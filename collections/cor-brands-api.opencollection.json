{
  "opencollection": "1.0.0",
  "info": {
    "name": "COR Attachments Brands API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Brands",
