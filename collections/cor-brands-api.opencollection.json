          "info": {
            "name": "Get Brands",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.projectcor.com/v1/brands",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (default: 1). Set to `false` to disable pagination."
              },
              {
                "name": "perPage",
                "value": "",
                "type": "query",
                "description": "Number of items per page (default: 20)."
              }
            ]
          },
          "docs": "Retrieves a paginated list of brands. By default, responses are paginated with 20 items per page."
        },
        {
          "info": {
            "name": "Create a brand",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.projectcor.com/v1/brands",
