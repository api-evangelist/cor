        {
          "id": "d83d9fe2-4cd4-4f8e-b571-09a5be18bf51",
          "name": "Get Categories and Labels",
          "request": {
            "name": "Get Categories and Labels",
            "description": {
              "content": "Returns categories for the company, each with its labels, filtered by which entity type those categories apply to (users, projects, or tasks). Names are returned in the authenticated user's language.\n\nUse **`model`** to choose the taxonomy: `user` for user/operation labels, `project` for project labels, and `task` for task labels. Any other value yields a validation error.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "categories",
                "labels-model"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "model",
                  "value": "user",
                  "description": "(Required) Entity type whose category/label tree to return: `user` (user labels), `project` (project labels), `task` (task labels)."
                },
                {
                  "disabled": false,
                  "key": "is_filterable",
                  "value": "true",
                  "description": "When `true` (default), only categories with `is_filterable` set are returned. Use `false` to include categories that are not marked filterable."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "0531f931-db1a-4bcb-be8b-60c40bd00074",
              "name": "List of categories with their associated labels",
