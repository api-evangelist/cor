{
  "opencollection": "1.0.0",
  "info": {
    "name": "COR Attachments Products API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Products",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Products",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.projectcor.com/v1/products",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (default: 1). Set to `false` to disable pagination."
              },
              {
                "name": "perPage",
                "value": "",
                "type": "query",
                "description": "Number of items per page (default: 20)."
              }
            ]
          },
          "docs": "Retrieves a paginated list of products. By default, responses are paginated with 20 items per page."
        },
        {
          "info": {
            "name": "Create a product",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.projectcor.com/v1/products",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new product entity."
        },
        {
          "info": {
            "name": "Get product by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.projectcor.com/v1/products/:product_id",
            "params": [
              {
                "name": "product_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get product by ID"
        },
        {
          "info": {
            "name": "Update a product",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.projectcor.com/v1/products/:product_id",
            "params": [
              {
                "name": "product_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "name",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "brand_id",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Update a product entity."
        },
        {
          "info": {
            "name": "Delete a product",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.projectcor.com/v1/products/:product_id",
            "params": [
              {
                "name": "product_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Destroy a product entity."
        }
      ]
    }
  ],
  "bundled": true
}